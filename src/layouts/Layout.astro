---
import '../styles/global.css';
import PetalCanvas from '../components/PetalCanvas.astro';
---

<!doctype html>
<html lang="en" class="smooth-scroll overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo-lily.jpg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>Shirui Wellness Spa | Hyderabad</title>
    <meta name="description" content="Shirui Wellness Spa in Hyderabad. Experience holistic balance, 3D interactive design, premium massages, Ayurvedic rituals, and signature pearl powder treatments." />
    
    <!-- Meta tags for premium design -->
    <meta name="theme-color" content="#000000" />
  </head>
  <body class="bg-black text-white relative overflow-x-hidden w-full max-w-full m-0 p-0">
    <!-- Global Scroll Progress Indicator -->
    <div id="scroll-progress-bar" class="fixed top-0 left-0 w-0 h-[3px] bg-gradient-to-r from-gold via-rose to-gold-dark z-[100] transition-all duration-75"></div>

    <!-- Global falling petals canvas overlay -->
    <PetalCanvas />
    
    <!-- Main content slots -->
    <slot />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const bar = document.getElementById('scroll-progress-bar');
        if (!bar) return;
        
        window.addEventListener('scroll', () => {
          const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
          bar.style.width = scrolled + '%';
        }, { passive: true });
      });
    </script>
  </body>
</html>
