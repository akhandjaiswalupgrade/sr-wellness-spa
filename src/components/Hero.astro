---
---

<section class="relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden bg-black select-none pt-24 sm:pt-32 md:pt-36 pb-16 md:pb-24" id="hero-section">
  
  <!-- Widescreen Cityscape Background Image (Static fallback for instant speed) -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/assets/hero-bg.jpg" 
      alt="Shirui Wellness Spa Luxury Pool & Hyderabad Skyline" 
      class="w-full h-full object-cover opacity-80 scale-100 transition-all duration-[2s]"
    />
  </div>
  
  <!-- Solid Dark Overlay for High-Contrast Text Legibility -->
  <div class="absolute inset-0 bg-black/75 z-10 pointer-events-none"></div>

  <!-- Hero Content Grid Wrapper -->
  <div class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 md:px-8 w-full flex flex-col justify-between h-full min-h-[75vh]">
    
    <!-- Main Content Row: Left Text & CTAs, Right Gold-Framed Landscape Image -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center my-auto w-full">
      
      <!-- Left Column: Copy & Direct Conversion Hooks -->
      <div class="lg:col-span-7 min-w-0 text-left flex flex-col justify-center animate-fade-in-left">
        <!-- Gold Badge -->
        <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-gold uppercase block mb-3 drop-shadow">
          Premium Spa & Body Massage in Hyderabad
        </span>
        
        <!-- Headline -->
        <h1 class="text-[28px] xs:text-[32px] sm:text-4xl md:text-5xl lg:text-[48px] font-playfair font-semibold text-white leading-tight mb-4 drop-shadow">
          Rejuvenate Your Body,<br />
          <span class="text-rose-light">Massage Vitality</span> Today!
        </h1>
        
        <!-- Description sentence-case -->
        <p class="text-sm sm:text-base text-white/85 leading-relaxed font-normal mb-8 max-w-xl drop-shadow">
          Welcome to Shirui Wellness Spa, Hitec City's premier luxury sanctuary. Experience world-class body massages, traditional oriental oil therapies, and signature Turkish Hammam rituals designed to dissolve muscle fatigue and restore absolute physical vitality.
        </p>

        <!-- Direct Conversion Call-to-Actions (CTAs) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full max-w-xl">
          <!-- 1. Book Session Button (Prominent) -->
          <button 
            class="open-booking-btn w-full sm:w-auto px-7 py-3.5 rounded-full font-bold tracking-[0.14em] text-xs sm:text-sm text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-[1.03] transition-all duration-300 shadow-[0_6px_22px_rgba(212,175,55,0.4)] uppercase text-center whitespace-nowrap"
          >
            Book Session
          </button>
          
          <!-- Mobile: 2 Buttons in 1 Row (Centered), Desktop: Inline Horizontal -->
          <div class="grid grid-cols-2 gap-3 w-full min-w-0 sm:w-auto">
            <!-- 2. Call Now Button -->
            <a 
              href="tel:+919030069708" 
              class="px-4 sm:px-6 py-3.5 rounded-full border border-gold/50 hover:border-gold bg-black/40 hover:bg-gold/10 font-bold tracking-[0.08em] text-xs sm:text-sm text-gold uppercase transition-all duration-300 text-center whitespace-nowrap flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              Call Now
            </a>
            
            <!-- 3. Book on WhatsApp Button -->
            <a 
              href="https://wa.me/919030069708" 
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 sm:px-6 py-3.5 rounded-full border border-emerald-500/50 hover:border-emerald-400 bg-emerald-950/20 hover:bg-emerald-900/40 font-bold tracking-[0.08em] text-xs sm:text-sm text-emerald-400 uppercase transition-all duration-300 flex items-center justify-center gap-2 whitespace-nowrap"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Gold-Framed LANDSCAPE Luxury Spa Visual (Wide, Not Portrait) -->
      <div class="lg:col-span-5 min-w-0 flex justify-center lg:justify-end animate-fade-in-right">
        <div class="relative w-full max-w-lg aspect-[16/10] rounded-2xl overflow-hidden border border-gold/30 bg-dark-card shadow-[0_20px_50px_rgba(0,0,0,0.85)] group select-none">
          <!-- Ambient overlay glare -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10 z-10 pointer-events-none"></div>
          <img 
            src="/assets/hero-landscape.jpg" 
            alt="Luxury Spa Relaxation Massage Therapy" 
            class="w-full h-full object-cover scale-[1.01] group-hover:scale-105 transition-transform duration-[1.5s]"
          />
        </div>
      </div>

    </div>

    <!-- Bottom Row: Trust highlights bar -->
    <div 
      id="hero-trust-bar"
      class="mt-10 lg:mt-8 pt-6 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-4 text-white/80 text-xs sm:text-sm tracking-wider uppercase text-center md:text-left select-none animate-fade-in-up font-semibold"
    >
      <div class="flex items-center gap-2 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-gold animate-pulse shrink-0"></span>
        <span class="whitespace-nowrap">Certified Therapists</span>
      </div>
      <div class="flex items-center gap-2 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-rose-light animate-pulse shrink-0"></span>
        <span class="whitespace-nowrap">Sanitized Rooms</span>
      </div>
      <div class="flex items-center gap-2 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-gold animate-pulse shrink-0"></span>
        <span class="whitespace-nowrap">100% Organic Oils</span>
      </div>
      <div class="flex items-center gap-2 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-rose-light animate-pulse shrink-0"></span>
        <span class="whitespace-nowrap">Shower & Valet</span>
      </div>
    </div>

  </div>

</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.innerWidth < 768;
    
    const tl = gsap.timeline();

    tl.from('.animate-fade-in-left', {
      opacity: 0,
      x: isMobile ? 0 : -30,
      y: isMobile ? 15 : 0,
      duration: 0.6,
      ease: 'power2.out'
    })
    .from('.animate-fade-in-right', {
      opacity: 0,
      x: isMobile ? 0 : 30,
      y: isMobile ? 15 : 0,
      duration: 0.6,
      ease: 'power2.out'
    }, '-=0.45')
    .from('.animate-fade-in-up', {
      opacity: 0,
      y: 15,
      duration: 0.5,
      ease: 'power2.out'
    }, '-=0.35');
  });
</script>
