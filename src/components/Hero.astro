---
---

<section class="relative w-full h-[95vh] md:h-screen flex flex-col items-center justify-center overflow-hidden bg-black select-none" id="hero-section">
  
  <!-- Full-Screen 3D Parallax Canvas -->
  <div class="absolute inset-0 z-0">
    <canvas id="hero-canvas" class="w-full h-full block opacity-0 transition-opacity duration-1000"></canvas>
  </div>
  
  <!-- Solid Black Overlay for Text Legibility and Contrast -->
  <div class="absolute inset-0 bg-black/60 z-10 pointer-events-none"></div>

  <!-- Hero Content Overlay (Tagline, Subtext, Booking & Pill Badges) -->
  <div class="relative z-20 max-w-5xl mx-auto px-4 text-center flex flex-col items-center justify-center mt-20 md:mt-28" id="hero-content">
    
    <!-- Animated taglines (High-fashion editorial typography mix of bold serif and flowing italic) -->
    <h2 class="text-[34px] md:text-[58px] lg:text-[76px] font-playfair tracking-[0.2em] font-semibold text-white leading-none mb-6 md:mb-8 drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)] flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0 animate-title" id="hero-banner-title">
      <span class="hero-word opacity-0 block md:inline-block transform translate-y-4 uppercase">RELAX.</span>
      <span class="hero-word opacity-0 block md:inline-block transform translate-y-4 md:ml-6 italic font-normal normal-case text-rose-light/95">Rejuvenate.</span>
      <span class="hero-word opacity-0 block md:inline-block transform translate-y-4 md:ml-6 uppercase text-gold">RENEW.</span>
    </h2>

    <!-- Poetic Spa Description subtext for business identity (Sentence case for premium editorial readability) -->
    <p 
      id="hero-subtext"
      class="text-xs md:text-sm font-montserrat text-white/70 max-w-[280px] md:max-w-xl mx-auto mb-8 md:mb-12 leading-relaxed font-light drop-shadow opacity-0 transform translate-y-4"
    >
      Indulge in certified body massages, traditional hot stone rituals, and signature hammam therapies in Hyderabad.
    </p>

    <!-- Glowing Polished Gold booking button (Immediate primary call to action) -->
    <div class="opacity-0 transform translate-y-6" id="hero-booking-container">
      <button 
        class="open-booking-btn relative px-12 py-3.5 md:px-16 md:py-4.5 rounded-full font-montserrat font-bold tracking-[0.25em] text-xs md:text-sm text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-105 transition-all duration-500 shadow-[0_6px_25px_rgba(212,175,55,0.35)] overflow-hidden group uppercase"
      >
        <!-- Hover sliding glare -->
        <span class="absolute top-0 -left-[100%] w-[50%] h-full bg-gradient-to-r from-transparent via-white/40 to-transparent skew-x-12 group-hover:left-[150%] transition-all duration-1000 ease-out"></span>
        
        <!-- Button content -->
        <span class="relative z-10 flex items-center gap-3">
          BOOK SESSION
        </span>
      </button>
    </div>

    <!-- Luxury Pill-Shaped Glass Badges to fill vertical space -->
    <div 
      id="hero-metrics"
      class="mt-12 md:mt-16 grid grid-cols-1 gap-3 max-w-[260px] mx-auto sm:max-w-none sm:flex sm:flex-row sm:items-center sm:justify-center sm:gap-6 opacity-0 transform translate-y-4 text-white/60 text-[9px] md:text-[10px] font-montserrat tracking-[0.2em] uppercase select-none font-medium"
    >
      <div class="px-4 py-2 rounded-full border border-gold/15 bg-gold/5 backdrop-blur-[2px] flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
        <span>Certified Therapists</span>
      </div>
      <div class="px-4 py-2 rounded-full border border-rose/15 bg-rose/5 backdrop-blur-[2px] flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-light animate-pulse"></span>
        <span>100% Organic Oils</span>
      </div>
      <div class="px-4 py-2 rounded-full border border-gold/15 bg-gold/5 backdrop-blur-[2px] flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
        <span>Private Suites</span>
      </div>
    </div>

  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-1.5 opacity-50 hover:opacity-100 transition-opacity cursor-pointer">
    <span class="text-[9px] font-montserrat tracking-[0.3em] uppercase text-gold">Explore</span>
    <div class="w-5 h-8 rounded-full border border-gold/40 flex justify-center py-1">
      <div class="w-1 h-1.5 bg-gold rounded-full animate-bounce"></div>
    </div>
  </div>

</section>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';

  class HeroParallax {
    canvas: HTMLCanvasElement;
    renderer: THREE.WebGLRenderer;
    scene: THREE.Scene;
    camera: THREE.PerspectiveCamera;
    plane: THREE.Mesh | null;
    textureLoader: THREE.TextureLoader;
    width: number;
    height: number;
    mouseX: number;
    mouseY: number;
    targetMouseX: number;
    targetMouseY: number;
    scrollOffset: number;

    constructor() {
      this.canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;

      this.width = this.canvas.clientWidth;
      this.height = this.canvas.clientHeight;

      this.mouseX = 0;
      this.mouseY = 0;
      this.targetMouseX = 0;
      this.targetMouseY = 0;
      this.scrollOffset = 0;

      this.renderer = new THREE.WebGLRenderer({
        canvas: this.canvas,
        antialias: true,
        powerPreference: "high-performance"
      });
      this.renderer.setSize(this.width, this.height, false);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      this.scene = new THREE.Scene();

      this.camera = new THREE.PerspectiveCamera(42, this.width / this.height, 0.1, 1000);
      this.camera.position.z = 7.5;

      this.plane = null;
      this.textureLoader = new THREE.TextureLoader();

      this.init();
      this.setupEvents();
      this.animate();
      this.introAnimation();
    }

    init() {
      this.textureLoader.load('/assets/hero-bg.jpg', (texture) => {
        texture.minFilter = THREE.LinearFilter;
        texture.generateMipmaps = false;

        const aspect = texture.image.width / texture.image.height;
        const scaleFactor = 1.2;
        let w = 7.5 * aspect;
        let h = 7.5;

        const geometry = new THREE.PlaneGeometry(w * scaleFactor, h * scaleFactor);
        const material = new THREE.MeshBasicMaterial({
          map: texture,
          side: THREE.FrontSide
        });

        this.plane = new THREE.Mesh(geometry, material);
        this.scene.add(this.plane);

        this.canvas.classList.remove('opacity-0');
        this.onResize();
      });
    }

    setupEvents() {
      window.addEventListener('mousemove', (e) => {
        this.targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
        this.targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      });

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        this.scrollOffset = scrolled * 0.004;
      });

      window.addEventListener('resize', this.onResize.bind(this));
    }

    onResize() {
      this.width = this.canvas.clientWidth;
      this.height = this.canvas.clientHeight;

      this.renderer.setSize(this.width, this.height, false);

      this.camera.aspect = this.width / this.height;
      this.camera.updateProjectionMatrix();

      if (this.plane && this.plane.material) {
        const texture = (this.plane.material as THREE.MeshBasicMaterial).map;
        if (texture && texture.image) {
          const imageAspect = texture.image.width / texture.image.height;
          const canvasAspect = this.width / this.height;
          
          let planeW = 7.5;
          let planeH = 7.5;

          if (canvasAspect > imageAspect) {
            planeW = 7.5 * canvasAspect;
            planeH = planeW / imageAspect;
          } else {
            planeH = 7.5;
            planeW = planeH * imageAspect;
          }

          const scaleFactor = 1.2;
          this.plane.scale.set(
            (planeW * scaleFactor) / (7.5 * imageAspect), 
            (planeH * scaleFactor) / 7.5, 
            1
          );
        }
      }
    }

    animate() {
      requestAnimationFrame(this.animate.bind(this));

      this.mouseX += (this.targetMouseX - this.mouseX) * 0.05;
      this.mouseY += (this.targetMouseY - this.mouseY) * 0.05;

      if (this.plane) {
        this.plane.rotation.y = this.mouseX * 0.045;
        this.plane.rotation.x = -this.mouseY * 0.03;
        this.plane.position.x = this.mouseX * 0.2;
        this.plane.position.y = (this.mouseY * 0.1) - this.scrollOffset;
      }

      this.renderer.render(this.scene, this.camera);
    }

    introAnimation() {
      const tl = gsap.timeline();

      // Tagline words appear one-by-one
      tl.to('.hero-word:nth-child(1)', {
        opacity: 1,
        y: 0,
        scale: 1.05,
        duration: 0.35,
        ease: 'power2.out'
      })
      .to('.hero-word:nth-child(1)', {
        scale: 1.0,
        duration: 0.1
      })
      .to('.hero-word:nth-child(2)', {
        opacity: 1,
        y: 0,
        scale: 1.05,
        duration: 0.35,
        ease: 'power2.out'
      }, '+=0.05')
      .to('.hero-word:nth-child(2)', {
        scale: 1.0,
        duration: 0.1
      })
      .to('.hero-word:nth-child(3)', {
        opacity: 1,
        y: 0,
        scale: 1.05,
        duration: 0.35,
        ease: 'power2.out'
      }, '+=0.05')
      .to('.hero-word:nth-child(3)', {
        scale: 1.0,
        duration: 0.1
      })
      // Fade in the poetic subtext description
      .to('#hero-subtext', {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power2.out'
      }, '-=0.1')
      // Fade and slide booking button up
      .to('#hero-booking-container', {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power2.out'
      }, '-=0.2')
      // Fade in the luxury metrics pill badges
      .to('#hero-metrics', {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power2.out'
      }, '-=0.15');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new HeroParallax();
  });
</script>
