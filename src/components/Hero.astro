---
---

<section class="relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden bg-black select-none py-24 md:py-32" id="hero-section">
  
  <!-- Widescreen Cityscape Background Image (Static fallback for instant speed) -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/assets/hero-bg.jpg" 
      alt="Shirui Wellness Spa Luxury Pool & Hyderabad Skyline" 
      class="w-full h-full object-cover opacity-85 scale-100 transition-all duration-[2s]"
    />
  </div>
  
  <!-- Solid Dark Overlay for High-Contrast Text Legibility -->
  <div class="absolute inset-0 bg-black/75 z-10 pointer-events-none"></div>

  <!-- Hero Content Grid Wrapper -->
  <div class="relative z-20 max-w-6xl mx-auto px-4 md:px-8 w-full flex flex-col justify-between h-full min-h-[75vh]">
    
    <!-- Main Content Row: Left Text & CTAs, Right Gold-Framed Image -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center my-auto">
      
      <!-- Left Column: Copy & Direct Conversion Hooks -->
      <div class="lg:col-span-7 text-left flex flex-col justify-center animate-fade-in-left">
        <!-- Gold Badge -->
        <span class="text-xs font-montserrat tracking-[0.3em] text-gold uppercase block mb-4 font-bold drop-shadow">
          Premium Spa & Body Massage in Hyderabad
        </span>
        <!-- Headline -->
        <h1 class="text-[32px] sm:text-4.5xl md:text-5xl lg:text-[54px] font-playfair font-semibold text-white leading-tight mb-6 drop-shadow">
          Rejuvenate Your Body,<br class="hidden sm:inline" />
          <span class="text-rose-light">Massage Vitality</span> Today!
        </h1>
        <!-- Description sentence-case -->
        <p class="text-xs sm:text-sm font-montserrat text-white/70 leading-relaxed font-light mb-8 max-w-xl drop-shadow">
          Welcome to Shirui Wellness Spa, Hitec City's premier luxury sanctuary. Experience world-class body massages, traditional oriental oil therapies, and signature Turkish Hammam rituals designed to dissolve muscle fatigue and restore absolute physical vitality.
        </p>

        <!-- Direct Conversion Call-to-Actions (CTAs) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <!-- 1. Book Ritual Modal CTA -->
          <button 
            class="open-booking-btn px-8 py-3.5 rounded-full font-montserrat font-bold tracking-[0.2em] text-xs text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-[1.03] transition-all duration-300 shadow-[0_6px_20px_rgba(212,175,55,0.35)] uppercase text-center"
          >
            Book Session
          </button>
          
          <!-- 2. Call Concierge Direct Link -->
          <a 
            href="tel:+919030069708" 
            class="px-8 py-3.5 rounded-full border border-gold/40 hover:border-gold hover:bg-gold/5 font-montserrat font-bold tracking-[0.2em] text-xs text-gold uppercase transition-all duration-300 text-center"
          >
            Call Concierge
          </a>
          
          <!-- 3. WhatsApp Direct Chat -->
          <a 
            href="https://wa.me/919030069708" 
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full border border-green-500/40 hover:border-green-500 hover:bg-green-500/5 font-montserrat font-bold tracking-[0.2em] text-xs text-green-400 uppercase transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            WhatsApp Us
          </a>
        </div>
      </div>

      <!-- Right Column: Gold-Framed High-End Treatment Image -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end animate-fade-in-right">
        <div class="relative w-full max-w-[340px] sm:max-w-[380px] aspect-[4/5] rounded-2xl overflow-hidden border border-gold/25 bg-dark-card shadow-[0_20px_50px_rgba(0,0,0,0.8)] group select-none">
          <!-- Gold overlay glares -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10 z-10"></div>
          <img 
            src="/assets/philosophy-right.jpg" 
            alt="Relaxing Hot Oil Massage Session" 
            class="w-full h-full object-cover scale-[1.02] group-hover:scale-105 transition-transform duration-[1.5s]"
          />
        </div>
      </div>

    </div>

    <!-- Bottom Row: Trust highlights bar -->
    <div 
      id="hero-trust-bar"
      class="mt-12 lg:mt-6 pt-8 border-t border-white/5 grid grid-cols-2 md:grid-cols-4 gap-6 text-white/50 text-[10px] sm:text-xs font-montserrat tracking-[0.2em] uppercase text-center md:text-left select-none animate-fade-in-up"
    >
      <div class="flex flex-col sm:flex-row items-center gap-2 justify-center md:justify-start">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse shrink-0"></span>
        <span class="text-white/80 font-bold">Certified Therapists</span>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-2 justify-center md:justify-start">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-light animate-pulse shrink-0"></span>
        <span class="text-white/80 font-bold">Sanitized Rooms</span>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-2 justify-center md:justify-start">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse shrink-0"></span>
        <span class="text-white/80 font-bold">100% Organic Oils</span>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-2 justify-center md:justify-start">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-light animate-pulse shrink-0"></span>
        <span class="text-white/80 font-bold">Shower & Valet</span>
      </div>
    </div>

  </div>

</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Check viewport
    const isMobile = window.innerWidth < 768;
    
    // Fast, responsive entrance timeline for high conversion elements
    const tl = gsap.timeline();

    tl.from('.animate-fade-in-left', {
      opacity: 0,
      x: isMobile ? 0 : -30,
      y: isMobile ? 15 : 0,
      duration: 0.6,
      ease: 'power2.out'
    })
    .from('.animate-fade-in-right', {
      opacity: 0,
      x: isMobile ? 0 : 30,
      y: isMobile ? 15 : 0,
      duration: 0.6,
      ease: 'power2.out'
    }, '-=0.45')
    .from('.animate-fade-in-up', {
      opacity: 0,
      y: 15,
      duration: 0.5,
      ease: 'power2.out'
    }, '-=0.35');
  });
</script>
