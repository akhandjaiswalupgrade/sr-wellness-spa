    title: "Traditional Thai Massage",
    image: "/assets/service-3.jpg",
    desc: "An energizing ritual combining passive stretching and acupressure. Restores energy flow, improves joint flexibility, and aligns body dynamics.",
    glow: "group-hover:opacity-60 group-hover:shadow-[0_0_60px_rgba(212,175,55,0.25)]",
    border: "border-gold/20 hover:border-gold/50"
  },
  {
    num: "4",
    title: "Balinese Ritual",
    image: "/assets/service-4.jpg",
    desc: "A holistic therapy combining gentle stretching, acupressure, and warm coconut oils to boost blood circulation and yield a deep sense of calm.",
    glow: "group-hover:opacity-60 group-hover:shadow-[0_0_60px_rgba(236,72,153,0.25)]",
    border: "border-rose/20 hover:border-rose/50"
  },
  {
    num: "5",
    title: "Aromatherapy Massage",
    image: "/assets/service-5.jpg",
    desc: "Bespoke sensory escape combining gentle rhythmic strokes with customized floral extracts (lavender, lemongrass) to quiet the mind.",
    glow: "group-hover:opacity-60 group-hover:shadow-[0_0_60px_rgba(212,175,55,0.25)]",
    border: "border-gold/20 hover:border-gold/50"
  },
  {
    num: "6",
    title: "Foot Reflexology",
    image: "/assets/service-6.jpg",
    desc: "Stimulation of specific pressure points on the soles of your feet corresponding to bodily organs, instantly relieving systemic fatigue.",
    glow: "group-hover:opacity-60 group-hover:shadow-[0_0_60px_rgba(236,72,153,0.25)]",
    border: "border-rose/20 hover:border-rose/50"
  },
  {
    num: "7",
    title: "Body Scrub & Polish",
    image: "/assets/service-1.jpg",
    desc: "Exfoliating brown sugar and sea salt scrub applied to remove dead skin cells, followed by a light moisturizing milk wash for glowing skin.",
    glow: "group-hover:opacity-60 group-hover:shadow-[0_0_60px_rgba(212,175,55,0.25)]",
    border: "border-gold/20 hover:border-gold/50"
  },
  {
    num: "8",
    title: "Detoxifying Body Wrap",
