---
const reviews = [
  {
    name: "Priya Sharma",
    location: "Jubilee Hills, Hyderabad",
    text: "The Ayurvedic massage at Shirui was a transcendental experience. The therapists are extremely skilled, and the warm oils made me drift into deep sleep. Easily the best spa in Hyderabad.",
    treatment: "Ayurvedic Harmony Massage"
  },
  {
    name: "Rahul Verma",
    location: "Gachibowli, Hyderabad",
    text: "Suffering from severe back tension due to long desk hours. The Deep Tissue therapy here was exactly what I needed. Professional, clean, and incredibly effective. Absolute relief.",
    treatment: "Deep Tissue Therapeutic"
  },
  {
    name: "Sneha & Amit",
    location: "Madhapur, Hyderabad",
    text: "The Turkish Hammam was amazing! It's like stepping into a marble sanctuary. The scrubbing and foam massage were so relaxing. Highly recommend the Couples Serenity package.",
    treatment: "Turkish Hammam"
  },
  {
    name: "Anjali Rao",
    location: "Neknampur, Hyderabad",
    text: "Stunning luxury environment. From the moment you enter, the scent of lavender and sound of flowing water set a peaceful tone. The pearl facial left my skin glowing for days.",
    treatment: "Aura Cleansing with Pearl"
  }
];
---

<section class="py-20 md:py-32 px-4 md:px-8 bg-black relative z-20 overflow-hidden border-t border-white/5" id="testimonials">
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-rose/5 blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto">
    <!-- Section Heading -->
    <div class="text-center mb-16 md:mb-24 select-none">
      <span class="text-xs font-montserrat tracking-[0.3em] text-gold uppercase block mb-3">Sanctuary Stories</span>
      <h2 class="text-3xl md:text-5xl font-playfair font-semibold text-white tracking-wide">
        Client Testimonials
      </h2>
      <div class="w-16 h-[1px] bg-gold/50 mx-auto mt-6"></div>
    </div>

    <!-- Review Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 select-none">
      {reviews.map((rev, index) => (
        <div 
          class="group p-6 rounded-2xl glassmorphism border border-white/5 hover:border-gold/20 flex flex-col justify-between transition-all duration-500 hover:-translate-y-2 shadow-lg hover:shadow-[0_10px_30px_rgba(212,175,55,0.08)]"
          id={`rev-card-${index}`}
        >
          <!-- Stars & Quote -->
          <div>
            <!-- Five Gold Stars SVGs -->
            <div class="flex items-center gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-gold fill-gold" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>

            <!-- Review Text -->
            <p class="text-xs md:text-sm text-white/75 leading-relaxed font-light font-montserrat italic mb-6">
              "{rev.text}"
            </p>
          </div>

          <!-- Client Footer Info -->
          <div class="border-t border-white/5 pt-4 mt-auto flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="text-xs font-montserrat font-bold text-white uppercase tracking-wider">{rev.name}</span>
              <!-- Verified Badge -->
              <span class="inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-gold/15 border border-gold/30" title="Verified Guest">
                <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </span>
            </div>
            <span class="text-[9px] font-montserrat tracking-widest text-gold/60 uppercase">{rev.location}</span>
            <span class="text-[9px] font-montserrat tracking-widest text-white/40 uppercase mt-1">Ritual: {rev.treatment.split(" ")[0]}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.innerWidth < 768;

    // Fast snappy reveal for reviews (instant on mobile to bypass ScrollTrigger lag)
    gsap.from('[id^="rev-card-"]', {
      opacity: 0,
      y: 15,
      duration: 0.45,
      stagger: 0.06,
      ease: 'power2.out',
      scrollTrigger: isMobile ? null : {
        trigger: '#testimonials',
        start: 'top 80%',
      }
    });
  });

  // Force ScrollTrigger coordinates recalculation after images are loaded
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });
</script>
