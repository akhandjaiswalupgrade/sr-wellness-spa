---
---

<section class="py-20 md:py-32 px-4 md:px-8 bg-black relative z-20 overflow-hidden border-t border-white/5" id="about">
  <!-- Glowing background blobs -->
  <div class="absolute top-1/3 left-0 w-72 h-72 rounded-full bg-gold/5 blur-[100px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-16">
    
    <!-- Left Column: Story & Highlights -->
    <div class="w-full md:w-[55%] flex flex-col text-left select-none" id="about-content">
      <span class="text-xs font-montserrat tracking-[0.25em] text-gold uppercase block mb-3">Our Story</span>
      <h2 class="text-3xl md:text-[40px] font-playfair font-semibold text-white mb-6 leading-tight">
        A Sanctuary of Peaceful Rejuvenation
      </h2>
      <p class="text-xs md:text-sm text-white/70 leading-relaxed font-light font-montserrat mb-8">
        Located in the serene heart of Hyderabad, Shirui Wellness Spa is a premium sanctuary dedicated to restoring harmony between mind, body, and spirit. Inspired by the purity and elegance of the Shirui Lily, we have curated a space where physical therapy and sensory relaxation converge.
      </p>

      <!-- Highlights list -->
      <div class="flex flex-col gap-5">
        <!-- Item 1: Hygiene -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-gold/10 border border-gold/25 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xs md:text-sm font-montserrat font-bold text-white uppercase tracking-wider mb-1">Strict Hygiene Standards</h4>
            <p class="text-[11px] md:text-xs text-white/50 leading-relaxed font-light font-montserrat">
              Medical-grade room sanitization, single-use linens, and natural organic massage oils ensure a completely safe, pure wellness environment.
            </p>
          </div>
        </div>

        <!-- Item 2: Expertise -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-rose/10 border border-rose/25 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-rose-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xs md:text-sm font-montserrat font-bold text-white uppercase tracking-wider mb-1">Certified Expert Therapists</h4>
            <p class="text-[11px] md:text-xs text-white/50 leading-relaxed font-light font-montserrat">
              Our professional practitioners are extensively trained in muscle anatomy, trigger-point pain release, and traditional oriental oil therapies.
            </p>
          </div>
        </div>

        <!-- Item 3: Customization -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-gold/10 border border-gold/25 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xs md:text-sm font-montserrat font-bold text-white uppercase tracking-wider mb-1">Personalized Pressure Objectives</h4>
            <p class="text-[11px] md:text-xs text-white/50 leading-relaxed font-light font-montserrat">
              From gentle lymphatic drainage to intense deep tissue myofascial release, we adapt massage depth to your specific physiological needs.
            </p>
          </div>
        </div>
      </div>

      <!-- Premium CTAs matching top section requirements -->
      <div class="flex items-center gap-4 mt-8">
        <button 
          class="open-booking-btn px-6 py-2.5 rounded-full font-montserrat font-bold tracking-widest text-[10px] text-black bg-gold hover:bg-gold-light uppercase transition-all duration-300 shadow-md shadow-gold/10 shrink-0"
          data-treatment="Ayurvedic Harmony Massage"
        >
          Book Session
        </button>
        <a 
          href="tel:+919030069708" 
          class="px-6 py-2.5 rounded-full border border-white/15 hover:border-white/35 font-montserrat font-bold tracking-widest text-[10px] text-white uppercase transition-all duration-300"
        >
          Call Now
        </a>
      </div>
    </div>

    <!-- Right Column: Visual Frame -->
    <div class="w-full md:w-[45%] flex justify-center relative select-none" id="about-visual">
      <!-- Glow background -->
      <div class="absolute w-48 h-48 rounded-full bg-rose/5 blur-[60px] -z-10 animate-pulse"></div>
      
      <!-- Styled Framed Image -->
      <div class="w-72 h-[350px] md:w-80 md:h-[420px] rounded-2xl overflow-hidden border border-gold/15 bg-dark-card shadow-2xl relative group">
        <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-700 z-10"></div>
        <img 
          src="/assets/about-sanctuary.jpg" 
          alt="Serene massage therapy session setup" 
          class="w-full h-full object-cover scale-[1.03] group-hover:scale-110 transition-transform duration-[1.5s]"
        />
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Fast snappy vertical fade in for content
    gsap.from('#about-content', {
      opacity: 0,
      y: 15,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about',
        start: 'top 75%',
      }
    });

    // Fast snappy vertical fade in for visual
    gsap.from('#about-visual', {
      opacity: 0,
      y: 15,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about',
        start: 'top 75%',
      }
    });
  });
</script>
