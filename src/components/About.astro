---
---

<section class="py-20 md:py-32 px-4 md:px-8 bg-black relative z-20 overflow-hidden border-t border-white/5" id="about">
  <!-- Glowing background blobs -->
  <div class="absolute top-1/3 left-0 w-72 h-72 rounded-full bg-gold/5 blur-[100px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-16">
    
    <!-- Left Column: Story & Highlights -->
    <div class="w-full md:w-[55%] flex flex-col text-left select-none" id="about-content">
      <span class="text-xs sm:text-sm font-bold tracking-[0.2em] text-gold uppercase block mb-3">Our Story</span>
      <h2 class="text-3xl sm:text-4xl md:text-[42px] font-playfair font-semibold text-white mb-5 leading-tight">
        A Sanctuary of Peaceful Rejuvenation
      </h2>
      <p class="text-sm sm:text-base text-white/85 leading-relaxed font-normal mb-8">
        Located in the serene heart of Hyderabad, Shirui Wellness Spa is a premier luxury sanctuary dedicated to restoring harmony between mind, body, and spirit. Inspired by the purity and elegance of the Shirui Lily, we have curated a space where physical therapy and sensory relaxation converge.
      </p>

      <!-- Highlights list -->
      <div class="flex flex-col gap-6">
        <!-- Item 1: Hygiene -->
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-sm sm:text-base font-bold text-white uppercase tracking-wider mb-1">Strict Hygiene Standards</h4>
            <p class="text-xs sm:text-sm text-white/75 leading-relaxed font-normal">
              Medical-grade room sanitization, single-use linens, and natural organic massage oils ensure a completely safe, pure wellness environment.
            </p>
          </div>
        </div>

        <!-- Item 2: Expertise -->
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-full bg-rose/10 border border-rose/30 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-rose-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-sm sm:text-base font-bold text-white uppercase tracking-wider mb-1">Certified Expert Therapists</h4>
            <p class="text-xs sm:text-sm text-white/75 leading-relaxed font-normal">
              Our professional practitioners are extensively trained in muscle anatomy, trigger-point pain release, and traditional oriental oil therapies.
            </p>
          </div>
        </div>

        <!-- Item 3: Customization -->
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-sm sm:text-base font-bold text-white uppercase tracking-wider mb-1">Personalized Pressure Objectives</h4>
            <p class="text-xs sm:text-sm text-white/75 leading-relaxed font-normal">
              From gentle lymphatic drainage to intense deep tissue myofascial release, we adapt massage depth to your specific physiological needs.
            </p>
          </div>
        </div>
      </div>

      <!-- Premium CTAs matching top section requirements -->
      <div class="flex items-center gap-4 mt-10">
        <button 
          class="open-booking-btn px-7 py-3 rounded-full font-bold tracking-wider text-xs sm:text-sm text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-105 uppercase transition-all duration-300 shadow-[0_4px_18px_rgba(212,175,55,0.3)] shrink-0"
          data-treatment="Ayurvedic Harmony Massage"
        >
          Book Session
        </button>
        <a 
          href="tel:+919030069708" 
          class="px-6 py-3 rounded-full border border-gold/40 hover:border-gold hover:bg-gold/10 font-bold tracking-wider text-xs sm:text-sm text-gold uppercase transition-all duration-300"
        >
          Call Now
        </a>
      </div>
    </div>

    <!-- Right Column: LANDSCAPE Visual Frame (Wide, Not Vertical) -->
    <div class="w-full md:w-[45%] flex justify-center relative select-none" id="about-visual">
      <!-- Glow background -->
      <div class="absolute w-56 h-56 rounded-full bg-gold/10 blur-[80px] -z-10 animate-pulse"></div>
      
      <!-- Styled Framed Image (Landscape 16:10) -->
      <div class="w-full max-w-lg aspect-[16/10] rounded-2xl overflow-hidden border border-gold/25 bg-dark-card shadow-[0_20px_50px_rgba(0,0,0,0.85)] relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10 z-10 pointer-events-none"></div>
        <img 
          src="/assets/about-sanctuary.jpg" 
          alt="Serene massage therapy sanctuary ambience" 
          class="w-full h-full object-cover scale-[1.01] group-hover:scale-105 transition-transform duration-[1.5s]"
        />
      </div>
    </div>

  </div>
</section>
