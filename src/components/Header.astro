---
---

<!-- Fixed Luxury Top Navigation Bar (Visible by default on first load) -->
<header id="main-navbar" class="fixed top-0 left-0 w-full z-40 bg-black/80 backdrop-blur-md border-b border-white/10 transition-all duration-500 py-3 px-4 sm:px-6 md:px-8 select-none">
  <div class="w-full max-w-6xl mx-auto flex items-center justify-between">
    
    <!-- Left: Brand Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <img 
        src="/assets/new-logo.png" 
        alt="Shirui Wellness Spa Logo" 
        class="h-9 sm:h-11 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
      />
    </a>

    <!-- Center: Desktop Navigation Links (Visible on Desktop) -->
    <nav class="hidden lg:flex items-center gap-7 text-xs font-montserrat tracking-[0.18em] uppercase font-medium">
      <a href="#about" class="text-white/75 hover:text-gold transition-colors duration-300">About</a>
      <a href="#services" class="text-white/75 hover:text-gold transition-colors duration-300">Treatments</a>
      <a href="#packages" class="text-white/75 hover:text-gold transition-colors duration-300">Packages</a>
      <a href="#pressure" class="text-white/75 hover:text-gold transition-colors duration-300">Therapy Selector</a>
      <a href="#philosophy" class="text-white/75 hover:text-gold transition-colors duration-300">Philosophy</a>
      <a href="#testimonials" class="text-white/75 hover:text-gold transition-colors duration-300">Reviews</a>
      <a href="#faq" class="text-white/75 hover:text-gold transition-colors duration-300">FAQ</a>
      <a href="#contact" class="text-white/75 hover:text-gold transition-colors duration-300">Contact</a>
    </nav>

    <!-- Right: Desktop CTA Buttons (Visible on Desktop) -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a 
        href="tel:+919030069708" 
        class="px-4 py-2 rounded-full border border-gold/30 hover:border-gold hover:bg-gold/5 font-montserrat font-bold tracking-[0.15em] text-[10px] text-gold uppercase transition-all duration-300 whitespace-nowrap"
      >
        Call Us
      </a>
      <button 
        class="open-booking-btn px-5 py-2 rounded-full font-montserrat font-bold tracking-[0.18em] text-[10px] text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-105 uppercase transition-all duration-300 shadow-[0_0_15px_rgba(212,175,55,0.25)] whitespace-nowrap"
      >
        Book Session
      </button>
    </div>

    <!-- Mobile Right: Hamburger Menu Trigger -->
    <div class="flex lg:hidden items-center gap-2 shrink-0">
      <button 
        id="mobile-menu-btn" 
        class="text-gold p-1.5 rounded-lg border border-gold/30 hover:border-gold bg-black/60 hover:bg-gold/10 transition-colors focus:outline-none flex items-center justify-center"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div 
  id="mobile-nav-drawer" 
  class="fixed inset-0 bg-black/95 backdrop-blur-xl z-50 pointer-events-none opacity-0 transition-all duration-500 flex flex-col justify-between p-6 select-none"
>
  <!-- Top Header in Drawer -->
  <div class="flex items-center justify-between border-b border-white/10 pb-4">
    <img 
      src="/assets/new-logo.png" 
      alt="Shirui Wellness Spa" 
      class="h-10 w-auto object-contain"
    />
    <button 
      id="mobile-drawer-close" 
      class="text-white/70 hover:text-gold p-2 focus:outline-none"
      aria-label="Close Navigation Menu"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Center Navigation Links -->
  <nav class="flex flex-col items-center gap-5 my-auto text-sm font-montserrat tracking-[0.22em] uppercase font-light text-white">
    <a href="#about" class="drawer-link hover:text-gold transition-colors duration-300">About Us</a>
    <a href="#services" class="drawer-link hover:text-gold transition-colors duration-300">Treatments</a>
    <a href="#packages" class="drawer-link hover:text-gold transition-colors duration-300">Packages</a>
    <a href="#pressure" class="drawer-link hover:text-gold transition-colors duration-300">Therapy Selector</a>
    <a href="#philosophy" class="drawer-link hover:text-gold transition-colors duration-300">Philosophy</a>
    <a href="#testimonials" class="drawer-link hover:text-gold transition-colors duration-300">Reviews</a>
    <a href="#hygiene" class="drawer-link hover:text-gold transition-colors duration-300">Hygiene</a>
    <a href="#contact" class="drawer-link hover:text-gold transition-colors duration-300">Contact Us</a>
  </nav>

  <!-- Bottom Actions in Drawer -->
  <div class="flex flex-col gap-3 pt-4 border-t border-white/10">
    <div class="grid grid-cols-2 gap-3">
      <a 
        href="tel:+919030069708" 
        class="py-3 rounded-full border border-gold/40 text-center font-montserrat font-bold tracking-widest text-xs text-gold uppercase"
      >
        Call Now
      </a>
      <a 
        href="https://wa.me/919030069708" 
        target="_blank"
        rel="noopener noreferrer"
        class="py-3 rounded-full border border-green-500/40 text-center font-montserrat font-bold tracking-widest text-xs text-green-400 uppercase flex items-center justify-center gap-1.5"
      >
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        WhatsApp
      </a>
    </div>
    <button 
      class="open-booking-btn w-full py-3.5 rounded-full font-montserrat font-bold tracking-[0.2em] text-xs text-black bg-gold hover:bg-gold-light uppercase transition-all duration-300 shadow-[0_0_20px_rgba(212,175,55,0.3)]"
    >
      Book Appointment
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('main-navbar');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const drawer = document.getElementById('mobile-nav-drawer');
    const drawerLinks = document.querySelectorAll('.drawer-link');

    // Scroll state change for navbar
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        navbar?.classList.add('bg-black/95', 'shadow-xl', 'border-gold/15', 'py-2.5');
        navbar?.classList.remove('bg-black/80', 'py-3');
      } else {
        navbar?.classList.remove('bg-black/95', 'shadow-xl', 'border-gold/15', 'py-2.5');
        navbar?.classList.add('bg-black/80', 'py-3');
      }
    });

    function openDrawer() {
      drawer?.classList.remove('pointer-events-none');
      drawer?.classList.replace('opacity-0', 'opacity-100');
      document.body.classList.add('overflow-hidden');
    }

    function closeDrawer() {
      drawer?.classList.add('pointer-events-none');
      drawer?.classList.replace('opacity-100', 'opacity-0');
      document.body.classList.remove('overflow-hidden');
    }

    menuBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);

    drawerLinks.forEach(link => {
      link.addEventListener('click', closeDrawer);
    });
  });
</script>
