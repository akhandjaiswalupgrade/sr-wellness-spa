---
const options = [
  {
    id: "soft",
    title: "Soft & Gentle",
    intensity: "Light Pressure",
    desc: "Long flowing, rhythmic strokes to calm the nervous system and encourage lymphatic drainage. Recommended for deep stress relief and first-time guests.",
    recommended: "Swedish, Aromatherapy, Foot Reflexology",
    border: "group-[.active]:border-gold/60 border-white/10",
    glow: "shadow-[0_0_20px_rgba(212,175,55,0.05)]"
  },
  {
    id: "medium",
    title: "Medium & Firm",
    intensity: "Moderate Pressure",
    desc: "A balanced blend of muscle rubbing, gentle stretching, and firm strokes to alleviate stiffness, release knots, and improve blood circulation.",
    recommended: "Balinese, Ayurvedic Massage, Scrub & Polish",
    border: "group-[.active]:border-rose/60 border-white/10",
    glow: "shadow-[0_0_25px_rgba(236,72,153,0.05)]"
  },
  {
    id: "deep",
    title: "Deep & Strong",
    intensity: "Intense Pressure",
    desc: "Deep, slow structural strokes targeting localized myofascial knots and muscle tightness. Essential for chronic back stiffness and athletic recovery.",
    recommended: "Deep Tissue, Traditional Thai, Turkish Hammam",
    border: "group-[.active]:border-gold/60 border-white/10",
    glow: "shadow-[0_0_30px_rgba(212,175,55,0.08)]"
  },
  {
    id: "trigger",
    title: "Trigger Points",
    intensity: "Focused Pressure",
    desc: "Localized static pressure applied specifically to hyper-irritable muscle points to release radiating nerve pain and restore muscle length.",
    recommended: "Targeted Back & Neck Massage, Reflexology",
    border: "group-[.active]:border-rose/60 border-white/10",
    glow: "shadow-[0_0_25px_rgba(236,72,153,0.05)]"
  },
  {
    id: "custom",
    title: "Customized Blend",
    intensity: "Bespoke Pressure",
    desc: "An adaptive, personalized sequence tailored during the session based on your real-time anatomical feedback and pain thresholds.",
    recommended: "Signature Wellness Packages, Couples Suite",
    border: "group-[.active]:border-gold/60 border-white/10",
    glow: "shadow-[0_0_30px_rgba(212,175,55,0.08)]"
  }
];
---

<section class="py-24 md:py-36 px-4 md:px-8 bg-black relative z-20 border-t border-white/5" id="pressure-section">
  <!-- Interactive radial background gradient -->
  <div class="absolute top-1/3 right-0 w-[500px] h-[500px] rounded-full bg-gold/5 blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto">
    
    <!-- Section Heading -->
    <div class="text-center mb-20 md:mb-28 select-none">
      <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-gold uppercase block mb-3">Therapy Fit</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-playfair font-semibold text-white tracking-wide">
        Which Therapy Suits You?
      </h2>
      <p class="text-sm sm:text-base text-white/80 font-normal mt-4 max-w-lg mx-auto">
        Identify the ideal muscle pressure depth for your session. Click any card below to select your customized relaxation profile.
      </p>
      <div class="w-20 h-[2px] bg-gradient-to-r from-transparent via-gold to-transparent mx-auto mt-6"></div>
    </div>

    <!-- Pressure Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 items-stretch">
      {options.map((opt) => (
        <div 
          class="pressure-card group relative p-6 rounded-2xl bg-black/50 border hover:border-gold/40 transition-all duration-300 cursor-pointer flex flex-col justify-between select-none"
          data-id={opt.id}
          data-title={opt.title}
        >
          <!-- Active State Border Indicator -->
          <div class="absolute inset-0 rounded-2xl border-2 border-transparent transition-all duration-300 opacity-0 group-[.active]:opacity-100 group-[.active]:border-gold pointer-events-none"></div>

          <div>
            <!-- Intensity -->
            <span class="text-xs font-bold text-gold block mb-1 uppercase tracking-widest">
              {opt.intensity}
            </span>
            <!-- Title -->
            <h3 class="text-xl font-playfair font-semibold text-white mb-4 group-[.active]:text-gold transition-colors duration-300">
              {opt.title}
            </h3>
            <!-- Description -->
            <p class="text-xs sm:text-sm text-white/80 leading-relaxed font-normal mb-6">
              {opt.desc}
            </p>
          </div>

          <div>
            <!-- Recommended list -->
            <div class="border-t border-white/10 pt-4">
              <span class="text-[11px] text-white/60 block mb-1 uppercase tracking-wider font-semibold">Recommended:</span>
              <span class="text-xs font-semibold text-white/90">{opt.recommended}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Dynamic CTA Banner (Shows selected tier feedback) -->
    <div class="mt-16 max-w-2xl mx-auto text-center select-none" id="pressure-feedback-banner">
      <div class="glassmorphism border border-white/10 p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="text-left">
          <span class="text-xs font-bold text-gold uppercase tracking-widest block mb-1">Your Selection</span>
          <h4 class="text-xl font-playfair font-semibold text-white" id="selected-pressure-text">
            Please select a pressure depth above...
          </h4>
        </div>
        
        <button 
          id="pressure-book-btn"
          disabled
          class="open-booking-btn px-8 py-3.5 rounded-full font-bold tracking-wider text-xs text-black bg-gold/50 uppercase cursor-not-allowed transition-all duration-300 whitespace-nowrap"
        >
          Book Selection
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Card Click Handling
    const cards = document.querySelectorAll('.pressure-card');
    const feedbackText = document.getElementById('selected-pressure-text');
    const bookBtn = document.getElementById('pressure-book-btn') as HTMLButtonElement;

    cards.forEach(card => {
      card.addEventListener('click', () => {
        cards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');

        const title = card.getAttribute('data-title');
        if (feedbackText) {
          feedbackText.innerHTML = `<span class="text-gold font-bold">${title}</span> Profile Selected`;
        }

        if (bookBtn) {
          bookBtn.disabled = false;
          bookBtn.classList.remove('cursor-not-allowed', 'bg-gold/50');
          bookBtn.classList.add('bg-gradient-to-r', 'from-gold', 'via-gold-light', 'to-gold-dark', 'hover:scale-105', 'shadow-[0_4px_16px_rgba(212,175,55,0.35)]');
          bookBtn.setAttribute('data-treatment', `Custom Pressure: ${title}`);
        }
      });
    });
  });
</script>
