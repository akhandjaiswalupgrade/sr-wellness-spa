---
const packages = [
  {
    title: "Signature Healing",
    duration: "90 Minutes",
    price: "₹5,499",
    desc: "A spiritual healing bundle utilizing Dosha-balancing oils, hot volcanic stones, and localized foot reflexology to ease structural exhaustion.",
    includes: ["Ayurvedic Hot Oil Massage", "Volcanic Hot Stone Therapy", "Targeted Foot Reflexology", "Complimentary Herbal Tea"],
    border: "border-gold/30 hover:border-gold/60",
    text: "text-gold"
  },
  {
    title: "Luxe Rejuvenation",
    duration: "90 Minutes",
    price: "₹4,999",
    desc: "Our most popular aesthetic package. Combines full-body exfoliation with deep muscle strokes to reveal radiant skin and relaxed musculature.",
    includes: ["Swedish Aromatherapy (60 Min)", "Organic Brown Sugar Scrub", "Detoxifying Steam Bath", "Moisturizing Milk Wash"],
    border: "border-rose/30 hover:border-rose/60",
    text: "text-rose-light",
    badge: "Best Seller"
  },
  {
    title: "Royal Hammam",
    duration: "90 Minutes",
    price: "₹5,999",
    desc: "A majestic thermal purification journey performed inside our heated marble suite. Deep skin exfoliation combined with cloud-like foam massage.",
    includes: ["Kessa Mitt Exfoliation", "Olive Oil Soap Foam Massage", "Detox Clay Body Mask", "Rosewater Infusion Polish"],
    border: "border-gold/30 hover:border-gold/60",
    text: "text-gold"
  },
  {
    title: "Couples Serenity",
    duration: "120 Minutes",
    price: "₹9,999",
    desc: "Bespoke dual relaxation in our private VIP couples suite. Shared luxury aromatherapy, hot stones, and organic skin facials.",
    includes: ["Dual Deep Tissue (75 Min)", "Hot Stone Massage Add-on", "Hydrating Gold Facial (30 Min)", "Private Suite Steam & Shower"],
    border: "border-rose/30 hover:border-rose/60",
    text: "text-rose-light"
  }
];
---

<section class="py-24 md:py-36 px-4 md:px-8 bg-black relative z-20 border-t border-white/5" id="packages-section">
  <!-- Backdrop ambient glow -->
  <div class="absolute bottom-1/4 left-1/3 w-[500px] h-[500px] bg-rose/5 blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto">
    
    <!-- Section Heading -->
    <div class="text-center mb-20 md:mb-28 select-none">
      <span class="text-xs sm:text-sm font-bold tracking-[0.25em] text-gold uppercase block mb-3">Bespoke Tiers</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-playfair font-semibold text-white tracking-wide">
        Signature Wellness Packages
      </h2>
      <p class="text-sm sm:text-base text-white/80 font-normal mt-4 max-w-lg mx-auto">
        Specially curated multi-therapy programs designed to provide the ultimate luxury relaxation experience.
      </p>
      <div class="w-20 h-[2px] bg-gradient-to-r from-transparent via-gold to-transparent mx-auto mt-6"></div>
    </div>

    <!-- Packages Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-stretch select-none">
      {packages.map((pkg, index) => (
        <div 
          class={`package-card relative rounded-2xl border bg-black/50 p-6 md:p-8 flex flex-col justify-between transition-all duration-500 hover:-translate-y-2 group shadow-xl ${pkg.border}`}
          id={`package-card-${index}`}
        >
          {pkg.badge && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest text-black bg-gold shadow-[0_4px_12px_rgba(212,175,55,0.5)]">
              {pkg.badge}
            </span>
          )}

          <div>
            <!-- Duration -->
            <span class="text-xs font-semibold text-gold-light block mb-2 uppercase tracking-widest">
              {pkg.duration}
            </span>
            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-playfair font-semibold text-white mb-4 group-hover:text-gold-light transition-colors duration-300">
              {pkg.title}
            </h3>
            <!-- Description -->
            <p class="text-sm text-white/80 leading-relaxed font-normal mb-6">
              {pkg.desc}
            </p>
            
            <!-- Bullet Points list of inclusions -->
            <div class="space-y-3 mb-8">
              {pkg.includes.map(inc => (
                <div class="flex items-start gap-2.5 text-xs sm:text-sm text-white/85 font-medium">
                  <svg class={`w-4 h-4 shrink-0 mt-0.5 ${pkg.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{inc}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <!-- Divider -->
            <div class="h-[1px] bg-white/10 w-full mb-6"></div>
            <!-- Price & Button -->
            <div class="flex items-center justify-between gap-4">
              <span class="text-2xl sm:text-3xl font-playfair font-bold text-gold tracking-wide">
                {pkg.price}
              </span>
              <button 
                class="open-booking-btn px-5 py-2.5 rounded-full font-bold tracking-wider text-xs text-black bg-gradient-to-r from-gold via-gold-light to-gold-dark hover:scale-105 uppercase transition-all duration-300 shadow-md whitespace-nowrap"
                data-treatment={`Package: ${pkg.title}`}
              >
                Book
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const isMobile = window.innerWidth < 768;

    gsap.from('.package-card', {
      opacity: 0,
      y: 15,
      scale: 0.98,
      duration: 0.45,
      stagger: 0.08,
      ease: 'power2.out',
      scrollTrigger: isMobile ? null : {
        trigger: '#packages-section',
        start: 'top 80%',
      }
    });
  });
</script>
