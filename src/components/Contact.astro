---
---

<section class="py-20 md:py-32 px-4 md:px-8 bg-black relative z-20 overflow-hidden border-t border-white/5" id="contact">
  <!-- Glowing background elements -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-gold/5 blur-[150px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto">
    
    <!-- Section Heading -->
    <div class="text-center mb-16 select-none">
      <span class="text-xs font-montserrat tracking-[0.3em] text-gold uppercase block mb-3">Sanctuary Path</span>
      <h2 class="text-3xl md:text-5xl font-playfair font-semibold text-white tracking-wide">
        Contact & Location
      </h2>
      <div class="w-16 h-[1px] bg-gold/50 mx-auto mt-6"></div>
    </div>

    <!-- Contact & Map Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-stretch">
      
      <!-- Left Column: Dark-Styled Google Map with Zoom-Hijack Protection Overlay -->
      <div class="w-full h-[320px] md:h-[420px] rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative select-none" id="contact-map">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3807.502941014169!2d78.3842193!3d17.3850125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb96ebca9991cb%3A0x64c8df634f199c08!2sNeknampur%2C%20Hyderabad%2C%20Telangana%20500089!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
          class="w-full h-full border-0 absolute inset-0"
          style="filter: invert(90%) hue-rotate(185deg) grayscale(85%) contrast(120%);"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Google Map of Shirui Wellness Spa Location"
          id="map-iframe"
        ></iframe>

        <!-- Zoom Hijack Overlay -->
        <div 
          id="map-overlay"
          class="absolute inset-0 bg-black/60 backdrop-blur-[2px] flex flex-col items-center justify-center cursor-pointer transition-all duration-500 z-10"
        >
          <span class="text-[10px] md:text-xs font-montserrat font-bold tracking-[0.25em] text-gold uppercase mb-2">Click to Interact with Map</span>
          <svg class="w-6 h-6 text-gold/80 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path>
          </svg>
        </div>
      </div>

      <!-- Right Column: Contact Details & Quick Links -->
      <div class="flex flex-col justify-between py-2 select-none" id="contact-info">
        <div class="flex flex-col gap-6">
          <span class="text-xs font-montserrat tracking-[0.2em] text-gold uppercase block">Get In Touch</span>
          
          <!-- Address -->
          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div class="font-montserrat">
              <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-1">Our Sanctuary</h4>
              <p class="text-[11px] md:text-xs text-white/60 leading-relaxed font-light">
                Plot No.1, First Floor, Patel Enclave, Beside Reliance Mart, Alkapur Road, Neknampur, Hyderabad, Telangana 500089
              </p>
            </div>
          </div>

          <!-- Phone & Email -->
          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <div class="font-montserrat">
              <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-1">Call Concierge</h4>
              <a href="tel:+919030069708" class="text-xs text-white/80 hover:text-gold transition-colors block font-semibold">+91 90300 69708</a>
              <span class="text-[10px] text-white/40 block mt-0.5">concierge@shiruispa.in</span>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="font-montserrat">
              <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-1">Operating Hours</h4>
              <p class="text-[11px] md:text-xs text-white/60 leading-relaxed font-light">
                Open Daily: 9:00 AM &ndash; 9:00 PM <span class="text-[10px] text-gold/60 block mt-0.5">(Including Public Holidays)</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Call & Chat Buttons -->
        <div class="flex items-center gap-4 mt-8">
          <!-- WhatsApp Concierge Button -->
          <a 
            href="https://wa.me/919030069708?text=Hello%20Shirui%20Spa,%20I%20would%20like%20to%20reserve%20a%20treatment%20ritual."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 px-6 py-2.5 rounded-full font-montserrat font-bold tracking-widest text-[10px] text-black bg-[#d4af37] hover:bg-[#f4e4bc] uppercase transition-all duration-300 shadow-md shadow-gold/10 shrink-0"
          >
            <!-- WhatsApp mini SVG icon -->
            <svg class="w-3.5 h-3.5 text-black fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.864-9.864.002-2.637-1.03-5.114-2.905-6.989-1.873-1.873-4.36-2.903-6.988-2.903-5.438 0-9.865 4.421-9.869 9.863-.001 1.637.428 3.238 1.242 4.646L1.89 19.9l4.757-1.246-.001.001zM17.472 14.382c-.3-.149-1.777-.877-2.052-.976-.275-.1-.476-.149-.675.15-.198.3-.77.976-.944 1.175-.174.199-.348.224-.648.075-.3-.15-1.266-.467-2.41-1.488-.89-.794-1.49-1.775-1.665-2.074-.174-.3-.019-.462.13-.611.135-.133.3-.349.45-.523.15-.174.2-.299.3-.499.1-.2.05-.375-.025-.524-.075-.15-.675-1.624-.925-2.224-.244-.589-.493-.508-.675-.518-.172-.01-.37-.012-.567-.012-.198 0-.52.074-.792.372-.272.298-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.777-.726 2.027-1.428.25-.701.25-1.3.175-1.428-.075-.128-.275-.203-.575-.353z"></path>
            </svg>
            WhatsApp Us
          </a>
          <a 
            href="tel:+919030069708" 
            class="px-6 py-2.5 rounded-full border border-white/15 hover:border-white/35 font-montserrat font-bold tracking-widest text-[10px] text-white uppercase transition-all duration-300"
          >
            Direct Call
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Floating WhatsApp Widget (Bottom Right Corner) -->
<a 
  href="https://wa.me/919030069708?text=Hello%20Shirui%20Spa,%20I%20would%20like%20to%20reserve%20a%20massage%20appointment." 
  target="_blank" 
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-[45] w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#25d366] flex items-center justify-center shadow-lg hover:shadow-[0_0_20px_rgba(37,211,102,0.6)] transform hover:scale-110 transition-all duration-300 hover:rotate-12 animate-pulse"
  aria-label="Chat on WhatsApp"
>
  <svg class="w-6 h-6 md:w-7 md:h-7 text-white fill-current" viewBox="0 0 24 24">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.864-9.864.002-2.637-1.03-5.114-2.905-6.989-1.873-1.873-4.36-2.903-6.988-2.903-5.438 0-9.865 4.421-9.869 9.863-.001 1.637.428 3.238 1.242 4.646L1.89 19.9l4.757-1.246-.001.001zM17.472 14.382c-.3-.149-1.777-.877-2.052-.976-.275-.1-.476-.149-.675.15-.198.3-.77.976-.944 1.175-.174.199-.348.224-.648.075-.3-.15-1.266-.467-2.41-1.488-.89-.794-1.49-1.775-1.665-2.074-.174-.3-.019-.462.13-.611.135-.133.3-.349.45-.523.15-.174.2-.299.3-.499.1-.2.05-.375-.025-.524-.075-.15-.675-1.624-.925-2.224-.244-.589-.493-.508-.675-.518-.172-.01-.37-.012-.567-.012-.198 0-.52.074-.792.372-.272.298-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.777-.726 2.027-1.428.25-.701.25-1.3.175-1.428-.075-.128-.275-.203-.575-.353z"></path>
  </svg>
</a>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Map overlay interaction
    const mapOverlay = document.getElementById('map-overlay');
    const mapContainer = document.getElementById('contact-map');

    mapOverlay?.addEventListener('click', () => {
      mapOverlay.classList.add('opacity-0', 'pointer-events-none');
    });

    // Re-lock scroll when mouse leaves the map container
    mapContainer?.addEventListener('mouseleave', () => {
      mapOverlay?.classList.remove('opacity-0', 'pointer-events-none');
    });
  });
</script>
